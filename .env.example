# ---------------------------------------------------------------------------
# Compose-only settings. Copy to `.env` if the defaults do not suit.
#
# Application settings do not live here — the backend reads backend/.env and the
# editor reads frontend/.env.local, exactly as they do without Docker.
# ---------------------------------------------------------------------------

# The database the stack creates for itself. Change the password before putting
# this anywhere other than a laptop.
#
# If a database volume already exists, PostgreSQL keeps the password it was
# first created with and ignores a new one here — so these must match the
# credentials in `backend/.env`, or the API cannot sign in to its own database.
POSTGRES_USER=yutomation
POSTGRES_PASSWORD=change-me-locally
POSTGRES_DB=yutomation

# Host ports. Change one if it is already taken; nothing inside the network
# moves with it.
POSTGRES_PORT=5432
BACKEND_PORT=4000
FRONTEND_PORT=3000
