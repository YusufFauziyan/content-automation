# ---------------------------------------------------------------------------
# Yu-tomation — environment template
#
# Copy to `.env` and adjust. Every value below is validated on startup by
# src/config/env.schema.ts; the application refuses to boot on invalid input.
# Never commit a real `.env`.
# ---------------------------------------------------------------------------

# --- Application -----------------------------------------------------------
# one of: development | test | production
NODE_ENV=development
# one of: debug | info | warn | error
LOG_LEVEL=debug
# Persist every log line to PostgreSQL through LogRepository.
LOG_PERSIST=true

# --- PostgreSQL (consumed by docker-compose) -------------------------------
POSTGRES_USER=yutomation
POSTGRES_PASSWORD=change-me-locally
POSTGRES_DB=yutomation
POSTGRES_PORT=5432

# --- PostgreSQL (consumed by Prisma) ---------------------------------------
# Host `localhost` when running the app on the host machine.
# Host `postgres`  when running the app inside docker-compose.
DATABASE_URL=postgresql://yutomation:change-me-locally@localhost:5432/yutomation?schema=public
# Optional. Shadow database used by `prisma migrate dev` to detect schema
# drift. Leave it unset and Prisma creates a temporary one itself; set it when
# your database user may not create databases. The named database must exist.
# SHADOW_DATABASE_URL=postgresql://yutomation:change-me-locally@localhost:5432/yutomation_shadow?schema=public
# Maximum connections held by the pg driver adapter pool.
DATABASE_POOL_SIZE=10

# --- Workflow --------------------------------------------------------------
# Retry policy applied to retryable errors only (PROJECT_RULES.md "Retry Policy").
WORKFLOW_MAX_RETRIES=3
# Backoff in milliseconds, one entry per retry attempt, comma separated.
WORKFLOW_BACKOFF_MS=1000,3000,10000

# --- 9 Router --------------------------------------------------------------
# Every model call goes through this router. A "combo" is an alias configured
# inside the router, so switching models — text or image — is an .env change
# and never a code change. No provider is ever named in the source.
NINE_ROUTER_BASE_URL=https://app-router.fauzyan.my.id/v1
NINE_ROUTER_API_KEY=sk-your-router-api-key
# Combo used for topics, scripts, scene plans and image briefs.
NINE_ROUTER_TEXT_COMBO=opus
# Combo used for image generation.
NINE_ROUTER_IMAGE_COMBO=gemini-image
# Abort a single request after this many milliseconds.
NINE_ROUTER_TIMEOUT=60000
NINE_ROUTER_MAX_RETRIES=3
NINE_ROUTER_BACKOFF_MS=1000,3000,10000

# --- Hugging Face (image fallback, optional) --------------------------------
# Used only when the 9 Router cannot produce an image. Leave HUGGINGFACE_API_KEY
# empty and the fallback does not exist: image generation depends on the router
# alone, exactly as before.
#
# HUGGINGFACE_IMAGE_MODEL is a provider route: the first segment names the
# inference provider, the rest is that provider's own model id. Which providers
# serve a given model changes without notice — check the current list with:
#   curl -H "Authorization: Bearer $HUGGINGFACE_API_KEY" \
#     "https://huggingface.co/api/models/black-forest-labs/FLUX.1-dev?expand[]=inferenceProviderMapping"
# The retired api-inference.huggingface.co host answers 410 for these models.
#
# Billing note: calls are charged against the account's inference credits, and
# one video needs one image per scene.
HUGGINGFACE_BASE_URL=https://router.huggingface.co
HUGGINGFACE_API_KEY=
HUGGINGFACE_IMAGE_MODEL=fal-ai/fal-ai/flux/dev
HUGGINGFACE_TIMEOUT=180000
HUGGINGFACE_MAX_RETRIES=2
HUGGINGFACE_BACKOFF_MS=1000,3000,10000

# --- Kokoro (text to speech) -----------------------------------------------
# OpenAI-compatible speech endpoint. `pnpm voice:up` runs one locally on 8880;
# a hosted server works just as well — only this URL changes.
# The local CPU image needs ~3 GB of memory to itself: on a Docker VM sized at
# the 2 GB default it is killed mid-synthesis on anything but short input.
KOKORO_BASE_URL=http://localhost:8880/v1
KOKORO_MODEL=kokoro
KOKORO_VOICE=af_heart
# Playback rate multiplier; 1 is the model's natural pace.
KOKORO_SPEED=1
KOKORO_TIMEOUT=120000
KOKORO_MAX_RETRIES=3
KOKORO_BACKOFF_MS=1000,3000,10000

# --- Narration -------------------------------------------------------------
# Speaking rate used to estimate block durations. Subtitle timing is derived
# from it, so tune it per voice and per language rather than in code.
# Measure it: generate a sample, divide its word count by its real duration.
# af_heart at speed 1 comes out at about 176.
NARRATION_WORDS_PER_MINUTE=176

# --- FFmpeg (video rendering) ----------------------------------------------
# Just the binary name when it is on PATH; an absolute path otherwise.
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
# 9:16 for short-form video.
VIDEO_WIDTH=1080
VIDEO_HEIGHT=1920
VIDEO_FPS=30
VIDEO_CODEC=libx264
AUDIO_CODEC=aac
VIDEO_PRESET=medium
# Constant Rate Factor: lower is better quality and a larger file.
VIDEO_CRF=23
# Rendering is expensive and a failure is rarely transient.
VIDEO_MAX_RETRIES=2
VIDEO_BACKOFF_MS=2000,10000
# A whole render, not one request.
VIDEO_TIMEOUT=900000
# How far a camera move travels, as a fraction of the frame.
VIDEO_CAMERA_INTENSITY=0.12
# Length of a fade or crossfade, in seconds.
VIDEO_TRANSITION_SECONDS=0.5

# --- Background music (optional) -------------------------------------------
# Leave unset to render narration only — the renderer skips the track rather
# than failing.
# BACKGROUND_MUSIC_PATH=assets/music/bed.mp3
BACKGROUND_MUSIC_VOLUME=0.12

# --- Pipeline --------------------------------------------------------------
# How far a full `generate` run goes. One of:
#   TOPIC | SCRIPT | SCENE | VISUAL_PLAN | IMAGE
#   NARRATION_PLAN | VOICE | SUBTITLE | RENDER_PLAN | COMPOSE
# Stop short of a stage whose external system is not ready — a run that ends
# there is a finished run, not a failed one — and move it on with no code
# change once that system works.
PIPELINE_LAST_STEP=COMPOSE

# --- Content generation ----------------------------------------------------
# How many candidate topics to try before giving up on finding a unique one.
TOPIC_MAX_ATTEMPTS=5
# Cosine similarity above which a topic counts as a semantic duplicate.
TOPIC_SIMILARITY_THRESHOLD=0.9
# Default spoken length a script is written for.
SCRIPT_TARGET_DURATION_SECONDS=45

# --- Image generation ------------------------------------------------------
# Portrait by default: the pipeline targets short-form vertical video. The
# aspect ratio named in a prompt is derived from these, never configured apart.
IMAGE_WIDTH=1024
IMAGE_HEIGHT=1792
# Quality wording appended to every image brief.
IMAGE_QUALITY=high detail, sharp focus, 8k

# --- Media (stateless) -----------------------------------------------------
# Scratch directory for generated media. Everything here is deleted after a
# verified upload — never point this at a directory you care about.
OUTPUT_DIR=output
# Directory holding the prompt files.
# Use `dist/prompts` when running the compiled build.
PROMPTS_DIR=src/prompts

# ---------------------------------------------------------------------------
# Publishing (Playwright) is introduced together with its service in a later
# milestone. Its configuration will be added here at that point, so that every
# variable in this file is actually validated and used.
# ---------------------------------------------------------------------------
