# Password that guards the workspace. Unset, it is `password123`.
APP_PASSWORD=password123

# Signs the session cookie. Must be set in production — an unset key lets any
# deployment mint cookies another one would accept.
AUTH_SECRET=change-me

# Where the backend HTTP API listens (backend/: `pnpm serve`).
YU_BACKEND_URL=http://localhost:4000

# Media root the backend writes into. Defaults to ../backend/output.
# YU_MEDIA_ROOT=/absolute/path/to/backend/output

# Speech samples in the New Workflow dialog are fetched here, so the key stays
# on the server. Same values as backend/.env.
ROUTER_SPEECH_BASE_URL=https://router.fauzyan.my.id/v1
ROUTER_SPEECH_API_KEY=
ROUTER_SPEECH_MODEL_PREFIX=google-tts
