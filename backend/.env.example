# Yu-tomation — backend configuration example
#
# Every value the application needs, validated at startup: an invalid file stops
# the process rather than failing later inside a workflow. Copy .env.example and
# fill in the four secrets marked REQUIRED.

# ─── Runtime ─────────────────────────────────────────────────────────────────
NODE_ENV=development
LOG_LEVEL=debug
LOG_PERSIST=true
HTTP_PORT=4000

# ─── Database ────────────────────────────────────────────────────────────────
POSTGRES_USER=yutomation
POSTGRES_PASSWORD=
POSTGRES_DB=yutomation
POSTGRES_PORT=5433
DATABASE_URL=postgresql://yutomation:yutomation-local@localhost:5433/yutomation?schema=public
DATABASE_POOL_SIZE=10

# ─── 9 Router — text and images ──────────────────────────────────────────────
# REQUIRED. Every model call goes through here; nothing talks to a provider
# directly. The combo names provider/model — `ag/` is antigravity.
#
# Image combos take an optional aspect suffix. Without one you get 1024x1024;
# `-9x16` gives 768x1376, which is what a vertical video wants.
NINE_ROUTER_BASE_URL=https://router.fauzyan.my.id/v1
NINE_ROUTER_API_KEY=
NINE_ROUTER_TEXT_COMBO=script-agent
NINE_ROUTER_IMAGE_COMBO=ag/gemini-3.1-flash-image
NINE_ROUTER_TIMEOUT=120000
NINE_ROUTER_MAX_RETRIES=3
NINE_ROUTER_BACKOFF_MS=1000,3000,10000

# ─── Credentials ─────────────────────────────────────────────────────────────
# Encrypts the publishing accounts at rest. Change it and every stored
# credential stops opening — they would have to be entered again.
CREDENTIALS_KEY=

# ─── Speech — 9 Router ───────────────────────────────────────────────────────
# One voice per language: models are `google-tts/{language}`. Confirmed for
# en id es ja ar fr de pt hi ko zh it nl tr vi th — an unknown code answers 502.
# The endpoint accepts a `voice` field and ignores it, so the language is the
# only choice there is.
#
# ROUTER_SPEECH_LANGUAGE is the default; a run started with a language uses that
# instead. The key is required — there is no other speech server.
ROUTER_SPEECH_BASE_URL=https://router.fauzyan.my.id/v1
ROUTER_SPEECH_API_KEY=
ROUTER_SPEECH_MODEL_PREFIX=google-tts
ROUTER_SPEECH_LANGUAGE=en
ROUTER_SPEECH_TIMEOUT=120000
ROUTER_SPEECH_MAX_RETRIES=2
ROUTER_SPEECH_BACKOFF_MS=1000,3000,10000

# ─── Narration ───────────────────────────────────────────────────────────────
# Only decides how much text goes in a block. Caption timing is measured from
# the audio, so this cannot put subtitles out of sync.
NARRATION_WORDS_PER_MINUTE=176
NARRATION_MAX_BLOCK_SECONDS=8
NARRATION_PAUSE_SECONDS=0.5

# ─── Video ───────────────────────────────────────────────────────────────────
# FFmpeg needs libass for burned-in subtitles. The docker wrappers exist because
# Homebrew's build does not have it.
FFMPEG_PATH=/Users/anaksoleh/project/yu-tomation/backend/scripts/ffmpeg-docker.sh
FFPROBE_PATH=/Users/anaksoleh/project/yu-tomation/backend/scripts/ffprobe-docker.sh
VIDEO_WIDTH=1080
VIDEO_HEIGHT=1920
VIDEO_FPS=30
VIDEO_CODEC=libx264
AUDIO_CODEC=aac
VIDEO_PRESET=medium
VIDEO_CRF=23
VIDEO_CAMERA_INTENSITY=0.12
VIDEO_TRANSITION_SECONDS=0.5
# How far the burned-in captions sit above the bottom edge, as a fraction of
# frame height. TikTok draws its own caption, handle and progress bar over the
# bottom ~15%, so anything lower than this ends up underneath them.
VIDEO_SUBTITLE_BOTTOM_FRACTION=0.16
# Which still becomes the cover, as a fraction of the way through. The stills
# have no burned-in caption, unlike every frame of the render — which is why
# the cover the platforms pick at 00:00 looks like a mistake.
VIDEO_COVER_AT_FRACTION=0.35
VIDEO_TIMEOUT=900000
VIDEO_MAX_RETRIES=2
VIDEO_BACKOFF_MS=2000,10000

# Optional bed under the narration. Missing file: the render skips it silently.
BACKGROUND_MUSIC_PATH=
BACKGROUND_MUSIC_VOLUME=0.12

# ─── Images ──────────────────────────────────────────────────────────────────
IMAGE_WIDTH=1024
IMAGE_HEIGHT=1792
IMAGE_QUALITY=high detail, sharp focus, 8k

# ─── Content ─────────────────────────────────────────────────────────────────
TOPIC_MAX_ATTEMPTS=5
TOPIC_SIMILARITY_THRESHOLD=0.9
SCRIPT_TARGET_DURATION_SECONDS=45

# ─── Pipeline ────────────────────────────────────────────────────────────────
# Stop once this step has succeeded. The steps after it are not built yet.
# UPLOAD publishes to the enabled TikTok account; with none connected the step
# is skipped, not failed, and the run still finishes.
PIPELINE_LAST_STEP=UPLOAD
WORKFLOW_MAX_RETRIES=3
WORKFLOW_BACKOFF_MS=1000,3000,10000

# ─── Media ───────────────────────────────────────────────────────────────────
# Everything here is disposable. Only metadata is kept.
OUTPUT_DIR=output
PROMPTS_DIR=src/prompts

# ─── Publishing (TikTok, browser) ────────────────────────────────────────────
# Leave TIKTOK_UPLOAD_URL empty to turn browser publishing off entirely.
# Capture a session with `pnpm tiktok:login`, then paste it into Credentials.
TIKTOK_UPLOAD_URL=https://www.tiktok.com/tiktokstudio/upload
TIKTOK_PROFILE_BASE_URL=https://www.tiktok.com
# Where "Open a browser and sign in" sends you. Five minutes to finish.
TIKTOK_LOGIN_URL=https://www.tiktok.com/login
TIKTOK_LOGIN_TIMEOUT=300000
# Watch the first runs. Headless is challenged far more often than a visible browser.
# The script writer produces between 3 and 8. TikTok captions are short and
# the tags compete with the words, so only the first few travel.
TIKTOK_MAX_HASHTAGS=5
TIKTOK_MADE_FOR_KIDS=false
TIKTOK_HEADLESS=false
TIKTOK_TIMEOUT=120000
TIKTOK_MAX_RETRIES=1
TIKTOK_BACKOFF_MS=5000,15000

# ─── Publishing (YouTube, browser) ───────────────────────────────────────────
# Leave YOUTUBE_UPLOAD_URL empty to turn YouTube publishing off entirely.
# Uploads land public; YouTube makes a Short out of anything vertical itself.
YOUTUBE_UPLOAD_URL=https://www.youtube.com/upload
YOUTUBE_PROFILE_BASE_URL=https://www.youtube.com
YOUTUBE_LOGIN_URL=https://accounts.google.com/ServiceLogin?service=youtube&continue=https%3A%2F%2Fwww.youtube.com%2F
YOUTUBE_LOGIN_TIMEOUT=300000
# YouTube's own ceiling: it ignores hashtags past the fifteenth.
YOUTUBE_MAX_HASHTAGS=15
# A legal declaration, not a preference. Set true only if the videos are
# *directed at* under-13s: YouTube then removes comments, notifications and
# personalised ads from them, which costs most of their reach. Educational
# videos that children happen to enjoy are normally false.
YOUTUBE_MADE_FOR_KIDS=false
YOUTUBE_HEADLESS=false
YOUTUBE_TIMEOUT=180000
YOUTUBE_MAX_RETRIES=1
YOUTUBE_BACKOFF_MS=5000,15000
